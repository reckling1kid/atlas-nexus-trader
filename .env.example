# Copy to .env for local configuration. Never commit secrets.
ATLAS_SYMBOL=DEMO
ATLAS_INITIAL_CASH=10000
ATLAS_MAX_POSITION_UNITS=1
ATLAS_MAX_DAILY_LOSS=500
# Optional local historical candle CSV. Required: timestamp,open,high,low,close; optional: volume.
# ATLAS_CANDLES_CSV=data/candles.csv
ATLAS_MODE=paper
ATLAS_BACKTEST_FEE_BPS=5
ATLAS_BACKTEST_SLIPPAGE_BPS=2
ATLAS_MIN_GAP_BPS=10
ATLAS_MAX_BAR_VOLATILITY=0.05
